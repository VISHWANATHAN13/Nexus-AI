# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Optional model overrides (otherwise config.yaml is used)
# NEXUS_MODEL_SMALL=
# NEXUS_MODEL_MID=
# NEXUS_MODEL_TOP=
# NEXUS_EMBEDDING_MODEL=

LOG_LEVEL=DEBUG
# NEXUS_LOG_FILE=logs/nexus_trace.jsonl

# Test switches (leave unset in normal use)
# NEXUS_OFFLINE=insurance_server      # pretend these MCP servers cannot start
# NEXUS_FORCE_CONFIDENCE=0.99         # make the validator report this confidence
# NEXUS_DEMO=1                        # index/search also includes demo_assets/poisoned_docs
